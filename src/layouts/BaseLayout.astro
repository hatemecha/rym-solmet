---
import "../styles/global.css";

import MotionController from "../components/MotionController.astro";
import MobileWhatsApp from "../components/MobileWhatsApp.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { getImage } from "astro:assets";
import meshUrl from "../assets/patterns/warped-mesh.svg?url";
import { heroImage } from "../data/projects";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site!);
const socialPhoto = await getImage({ src: heroImage.src, width: 1200, height: 630, fit: "cover", format: "jpeg", quality: 85 });
const socialImage = new URL(socialPhoto.src, Astro.site!);
const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${canonical}#negocio`,
  name: site.name,
  url: canonical.href,
  description: site.description,
  image: socialImage.href,
  telephone: site.phoneDisplay,
  email: site.email,
  areaServed: { "@type": "City", name: "Bahía Blanca" },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111210" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={heroImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={heroImage.alt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(business).replace(/</g, "\\u003c")} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" as="image" href={meshUrl} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <MobileWhatsApp />
    <MotionController />
    <PhotoGallery />
  </body>
</html>
