---
import "../styles/global.css";

import MotionController from "../components/MotionController.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { getImage } from "astro:assets";
import meshUrl from "../assets/patterns/warped-mesh.svg?url";
import { heroImage } from "../data/projects";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site!);
const home = new URL(base, Astro.site!);
const socialPhoto = await getImage({ src: heroImage.src, width: 1200, height: 630, fit: "cover", format: "jpeg", quality: 85 });
const socialImage = new URL(socialPhoto.src, Astro.site!);
const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${home}#negocio`,
  name: site.name,
  url: home.href,
  description: site.description,
  image: socialImage.href,
  telephone: site.phoneDisplay,
  email: site.email,
  areaServed: { "@type": "City", name: "Bahía Blanca" },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; media-src 'self'; worker-src 'self'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#111210" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={heroImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={heroImage.alt} />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(business).replace(/</g, "\\u003c")} />}
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="preload" as="image" href={meshUrl} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <MotionController />
    <PhotoGallery />
  </body>
</html>
