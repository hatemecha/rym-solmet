---
import ArrowIcon from "./ArrowIcon.astro";
import BrandLogo from "./BrandLogo.astro";
import { site } from "../data/site";
---

<header class="site-header" data-site-header data-surface="ink">
  <div class="site-header__inner page-shell">
    <a class="wordmark" href="#inicio" aria-label="RYM Solmet, volver al inicio">
      <BrandLogo priority />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <div class="site-nav__links">
        <a href="#trabajos">Trabajos</a>
        <a href="#servicios">Qué hacemos</a>
      </div>
      <a class="site-nav__contact" href={site.whatsapp} aria-label="Consultar por WhatsApp">
        <span>Consultar</span>
        <ArrowIcon />
      </a>
    </nav>
  </div>
</header>
