---
import ArrowIcon from "./ArrowIcon.astro";
import BrandLogo from "./BrandLogo.astro";
import WarpedGrid from "./WarpedGrid.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<section class="closing-chapter contact" id="contacto" aria-labelledby="contact-title" data-chapter="ink">
  <WarpedGrid variant="contact" tone="on-ink" class="contact__grid" />
  <div class="contact__stage page-shell">
    <div class="contact__inner">
      <div class="contact__intro" data-reveal="heading">
        <h2 id="contact-title">Consultas de trabajo.</h2>
        <p>
          Herrería y fabricación a medida en {site.location}.
        </p>
      </div>
      <div class="contact__panel" data-reveal="panel" data-reveal-delay="100">
        <a class="contact__primary" href={site.whatsapp}>
          <span>Consultar por WhatsApp</span>
          <ArrowIcon />
        </a>
        <dl>
          <div>
            <dt>Contacto</dt>
            <dd>{site.contactName}</dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd><a href={site.whatsapp}>{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt>Correo</dt>
            <dd><a href={site.mailto}>{site.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
  <footer class="site-footer">
    <div class="site-footer__inner page-shell">
      <BrandLogo class="site-footer__brand" />
      <p class="site-footer__meta">© {year} · {site.location}</p>
      <div class="site-footer__links" aria-label="Contacto en el pie">
        <a href={site.whatsapp}>WhatsApp</a>
        <a href={site.mailto}>Correo</a>
      </div>
    </div>
  </footer>
</section>
