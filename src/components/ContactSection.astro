---
import ArrowIcon from "./ArrowIcon.astro";
import SurfacePattern from "./SurfacePattern.astro";
import GrainField from "./GrainField.astro";
import { site } from "../data/site";
---

<section class="closing-chapter contact" id="contacto" aria-labelledby="contact-title" data-chapter="ink">
  <GrainField reverse />
  <SurfacePattern variant="diagonal" />
  <div class="contact__stage page-shell">
    <div class="contact__inner">
      <div class="contact__intro" data-reveal="heading">
        <h2 id="contact-title">Consultas de trabajo.</h2>
        <p>
          Herrería y fabricación a medida en {site.location}.
        </p>
      </div>
      <div class="contact__panel" data-reveal="panel" data-reveal-delay="100">
        <a class="contact__primary" href={site.whatsapp}>
          <span>Consultar por WhatsApp</span>
          <ArrowIcon />
        </a>
        <dl>
          <div>
            <dt>Contacto</dt>
            <dd>{site.contactName}</dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd><a href={site.whatsapp}>{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt>Correo</dt>
            <dd><a href={site.mailto}>{site.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
