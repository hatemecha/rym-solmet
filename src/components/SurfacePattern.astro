---
import mesh from "../assets/patterns/warped-mesh.svg?url";
interface Props { variant: "grid" | "dots" | "diagonal"; }
const { variant } = Astro.props;
---

<div class={`surface-pattern surface-pattern--${variant}`} data-surface-pattern={variant} aria-hidden="true">
  <div class="surface-pattern__field" style={{ backgroundImage: `url(${mesh})` }}></div>
  {variant === "grid" && (
    <div class="surface-pattern__field surface-pattern__field--focus" style={{ backgroundImage: `url(${mesh})` }}></div>
  )}
</div>

<style>
  .surface-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.13;
  }
  .surface-pattern__field {
    position: absolute;
    inset: -12px;
    background-repeat: repeat;
    background-size: 900px 900px;
  }
  .surface-pattern__field--focus {
    opacity: 0;
    z-index: 1;
    background-position: center 35%;
    -webkit-mask-image: radial-gradient(ellipse var(--focus-r, 26%) var(--focus-r, 26%) at var(--focus-x, 50%) var(--focus-y, 50%), #000, transparent 72%);
    mask-image: radial-gradient(ellipse var(--focus-r, 26%) var(--focus-r, 26%) at var(--focus-x, 50%) var(--focus-y, 50%), #000, transparent 72%);
  }
  .surface-pattern--grid {
    mask-image: radial-gradient(ellipse 120% 95% at 12% 55%, #0002, #0006 40%, #000 78%);
  }
  .surface-pattern--grid .surface-pattern__field {
    background-position: center 35%;
  }
  .surface-pattern--dots {
    filter: invert(1);
    opacity: 0.16;
    mask-image: linear-gradient(#0000 0%, #0006 120px, #000 280px);
  }
  .surface-pattern--dots .surface-pattern__field {
    background-position: 38% -180px;
    background-size: 1050px 1050px;
  }
  .surface-pattern--diagonal {
    mask-image: linear-gradient(#000 0%, #0008 18%, #0008 82%, #000 100%);
  }
  .surface-pattern--diagonal .surface-pattern__field {
    background-position: 68% 80%;
    background-size: 800px 800px;
  }
  @media (max-width: 47.999rem) {
    .surface-pattern__field { background-size: 620px 620px; }
    .surface-pattern--dots .surface-pattern__field { background-size: 740px 740px; }
    .surface-pattern--diagonal .surface-pattern__field { background-position: 45% center; }
  }
</style>
