<button
  class="theme-toggle"
  type="button"
  aria-label="Cambiar a modo oscuro"
  title="Cambiar tema"
>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z"></path>
  </svg>
</button>

<script>
  const storageKey = "rym-solmet-theme";
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const applyTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    toggle?.setAttribute("aria-label", `Cambiar a modo ${theme === "dark" ? "claro" : "oscuro"}`);
    toggle?.setAttribute("aria-pressed", String(theme === "dark"));
    themeColor?.setAttribute("content", theme === "dark" ? "#111310" : "#f2f0eb");
  };

  toggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    try {
      localStorage.setItem(storageKey, nextTheme);
    } catch {
      // El tema sigue funcionando durante la visita si el navegador bloquea el almacenamiento.
    }
    applyTheme(nextTheme);
  });

  applyTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
</script>
