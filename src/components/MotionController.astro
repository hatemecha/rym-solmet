<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotion.matches) {
    gsap.registerPlugin(ScrollTrigger);

    const coarsePointer = window.matchMedia("(pointer: coarse)").matches;
    if (!coarsePointer) {
      const lenis = new Lenis({
        duration: 1.05,
        smoothWheel: true,
      });

      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    }
    document.documentElement.classList.add("has-motion");

    const withTrigger = (target: Element, options: { from: gsap.TweenVars; to: gsap.TweenVars }) => {
      gsap.fromTo(target, options.from, {
        ...options.to,
        scrollTrigger: {
          trigger: target,
          start: "top 86%",
          end: "top 52%",
          scrub: 0.55,
        },
      });
    };

    document.querySelectorAll('[data-reveal="heading"]').forEach((heading) => {
      const title = heading.querySelector("h2");
      const supporting = heading.querySelector("p");
      if (title) {
        withTrigger(title, {
          from: { clipPath: "inset(0 0 100% 0)", y: 20 },
          to: { clipPath: "inset(0)", y: 0, ease: "none" },
        });
      }
      if (supporting) {
        withTrigger(supporting, {
          from: { autoAlpha: 0, y: 12 },
          to: { autoAlpha: 1, y: 0, ease: "none" },
        });
      }
      gsap.fromTo(heading, { "--line-scale": 0 }, {
        "--line-scale": 1,
        ease: "none",
        scrollTrigger: { trigger: heading, start: "top 84%", end: "top 58%", scrub: 0.45 },
      });
    });

    document.querySelectorAll('[data-reveal="image"]').forEach((media) => {
      withTrigger(media, {
        from: { clipPath: "inset(0 0 12% 0)", y: 28 },
        to: { clipPath: "inset(0)", y: 0, ease: "none" },
      });
      const caption = media.parentElement?.querySelector('[data-reveal="caption"]');
      if (caption) {
        withTrigger(caption, {
          from: { autoAlpha: 0, y: 12 },
          to: { autoAlpha: 1, y: 0, ease: "none" },
        });
      }
    });

    const hero = document.querySelector(".hero");
    const heroImage = document.querySelector(".hero__image");

    if (hero && heroImage) {
      gsap.to(heroImage, {
        yPercent: coarsePointer ? 2 : 5,
        scale: coarsePointer ? 1.02 : 1.035,
        ease: "none",
        scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.65 },
      });
    }

    document
      .querySelectorAll(".project--slot-3 .project__media img, .project--slot-5 .project__media img")
      .forEach((image) => {
      if (coarsePointer) {
        return;
      }
      gsap.to(image, {
        yPercent: -4,
        scale: 1.025,
        ease: "none",
        scrollTrigger: { trigger: image.closest(".project"), start: "top bottom", end: "bottom top", scrub: 0.75 },
      });
      });

    const list = document.querySelector(".capabilities__list");
    if (list) {
      gsap.fromTo(list.querySelectorAll("li"), { x: -18, autoAlpha: 0 }, {
        x: 0,
        autoAlpha: 1,
        stagger: 0.09,
        ease: "none",
        scrollTrigger: { trigger: list, start: "top 84%", end: "top 42%", scrub: 0.5 },
      });
    }

    document.querySelectorAll("[data-warped-grid]").forEach((grid) => {
      if (grid.classList.contains("portfolio__grid")) {
        return;
      }

      const parent = grid.parentElement;
      if (!parent) {
        return;
      }
      gsap.to(grid, {
        yPercent: coarsePointer ? 0.5 : 2.5,
        ease: "none",
        scrollTrigger: { trigger: parent, start: "top bottom", end: "bottom top", scrub: 1.1 },
      });
    });

    ScrollTrigger.refresh();
  }
</script>
