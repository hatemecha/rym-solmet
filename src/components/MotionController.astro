<script>
  import "lenis/dist/lenis.css";
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const header = document.querySelector<HTMLElement>("[data-site-header]")!;
  const opening = document.querySelector<HTMLElement>(".opening-chapter")!;
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
  const headerHeight = () => header.getBoundingClientRect().height;
  // Lenis 1.3 reads scroll-padding itself. Only compensate the difference
  // between the native CSS offset and the measured fixed header.
  const anchorOffset = () => parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) - headerHeight() - 8;

  // Functional state is independent of the visitor's motion preference.
  const updateHeader = () => {
    const edge = headerHeight();
    const chapter = chapters.find((section) => {
      const rect = section.getBoundingClientRect();
      return rect.top <= edge && rect.bottom > edge;
    });
    header.dataset.surface = chapter?.dataset.chapter ?? "ink";
    header.classList.toggle("is-compact", opening.getBoundingClientRect().bottom <= edge);
  };
  ScrollTrigger.create({ start: 0, end: "max", onUpdate: updateHeader, onRefresh: updateHeader });
  updateHeader();

  const media = gsap.matchMedia();
  media.add({
    desktop: "(min-width: 768px) and (hover: hover) and (pointer: fine)",
    reduced: "(prefers-reduced-motion: reduce)",
    all: "all",
  }, (context) => {
    const { desktop, reduced } = context.conditions!;
    let lenis: Lenis | undefined;
    let cleanupPatternMotion = () => {};
    const tick = (time: number) => lenis?.raf(time * 1000);
    const pause = () => lenis?.stop();
    const resume = () => { lenis?.start(); lenis?.resize(); };
    const resize = new ResizeObserver(() => {
      if (lenis) lenis.options.anchors = { offset: anchorOffset() };
    });
    if (desktop && !reduced) {
      lenis = new Lenis({
        duration: 1.05,
        smoothWheel: true,
        syncTouch: false,
        anchors: { offset: anchorOffset() },
        stopInertiaOnNavigate: true,
        prevent: (node) => node.classList.contains("pswp"),
      });
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add(tick);
      gsap.ticker.lagSmoothing(0);
      resize.observe(header);
      if (document.documentElement.classList.contains("gallery-open")) lenis.stop();
    }
    document.addEventListener("gallery:open", pause);
    document.addEventListener("gallery:close", resume);

    if (!reduced) {
      const reveal = (target: Element, from: gsap.TweenVars, to: gsap.TweenVars) => {
        gsap.fromTo(target, from, {
          ...to,
          duration: desktop ? 0.65 : 0.45,
          ease: desktop ? "none" : "power2.out",
          scrollTrigger: {
            trigger: target, start: "top 92%", end: "top 60%",
            ...(desktop ? { scrub: 0.45 } : { once: true }),
          },
        });
      };
      document.querySelectorAll('[data-reveal="heading"]').forEach((heading) => {
        const title = heading.querySelector("h2");
        const supporting = heading.querySelector("p");
        if (title) reveal(title, desktop ? { clipPath: "inset(0 0 100% 0)", y: 20 } : { y: 12 },
          desktop ? { clipPath: "inset(0)", y: 0 } : { y: 0 });
        if (supporting) reveal(supporting, { opacity: 0.35, y: desktop ? 12 : 8 }, { opacity: 1, y: 0 });
        if (desktop) reveal(heading, { "--line-scale": 0 }, { "--line-scale": 1 });
      });
      document.querySelectorAll('[data-reveal="image"]').forEach((image) => {
        reveal(image, desktop ? { clipPath: "inset(0 0 12% 0)", y: 28 } : { y: 12 },
          desktop ? { clipPath: "inset(0)", y: 0 } : { y: 0 });
      });
      const list = document.querySelector(".capabilities__list");
      if (list) reveal(list, { x: desktop ? -18 : -8, opacity: 0.35 }, { x: 0, opacity: 1 });
      if (desktop) {
        const contactPattern = document.querySelector<HTMLElement>(
          '[data-surface-pattern="diagonal"] .surface-pattern__field',
        );
        if (contactPattern) {
          const patternMotion = gsap.to(contactPattern, {
            x: 8,
            y: -6,
            duration: 13,
            ease: "sine.inOut",
            repeat: -1,
            yoyo: true,
            paused: true,
          });
          let patternTrigger: ScrollTrigger | undefined;
          patternTrigger = ScrollTrigger.create({
            trigger: ".closing-chapter",
            start: "top bottom",
            end: "bottom top",
            onToggle: syncPatternMotion,
          });
          function syncPatternMotion() {
            const shouldRun = patternTrigger?.isActive === true && document.visibilityState === "visible";
            contactPattern!.style.willChange = shouldRun ? "transform" : "auto";
            if (shouldRun) patternMotion.play();
            else patternMotion.pause();
          }
          document.addEventListener("visibilitychange", syncPatternMotion);
          syncPatternMotion();
          cleanupPatternMotion = () => {
            document.removeEventListener("visibilitychange", syncPatternMotion);
            patternTrigger?.kill();
            patternMotion.kill();
            gsap.set(contactPattern, { clearProps: "transform,willChange" });
          };
        }
        gsap.to(".hero__image", {
          yPercent: 4, scale: 1.025, ease: "none",
          scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: 0.65 },
        });
        document.querySelectorAll(".project--slot-3 .project__media img, .project--slot-5 .project__media img")
          .forEach((image) => gsap.to(image, {
            yPercent: -3, scale: 1.025, ease: "none",
            scrollTrigger: { trigger: image.closest(".project"), start: "top bottom", end: "bottom top", scrub: 0.75 },
          }));
      }
    }
    return () => {
      cleanupPatternMotion();
      resize.disconnect();
      document.removeEventListener("gallery:open", pause);
      document.removeEventListener("gallery:close", resume);
      gsap.ticker.remove(tick);
      lenis?.destroy();
    };
  });
  document.fonts.ready.then(() => ScrollTrigger.refresh());
  window.addEventListener("pageshow", () => { ScrollTrigger.refresh(); updateHeader(); });
</script>
