<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const opening = document.querySelector<HTMLElement>(".opening-chapter");
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];

  if (header && opening) {
    const headerHeight = () => header.getBoundingClientRect().height;
    let scheduled = false;
    const updateHeader = () => {
      const edge = headerHeight();
      const previous = chapters.find((section) => section.dataset.chapter === header.dataset.surface && (() => {
        const rect = section.getBoundingClientRect();
        return rect.top <= edge + 16 && rect.bottom > edge - 16;
      })());
      const chapter = previous ?? chapters.find((section) => {
        const rect = section.getBoundingClientRect();
        return rect.top <= edge && rect.bottom > edge;
      });
      header.dataset.surface = chapter?.dataset.chapter ?? "ink";
      const boundary = opening.getBoundingClientRect().bottom;
      const compact = header.classList.contains("is-compact");
      header.classList.toggle("is-compact", compact ? boundary <= edge + 32 : boundary <= edge - 16);
      scheduled = false;
    };
    const scheduleHeader = () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(updateHeader);
      }
    };
    window.addEventListener("scroll", scheduleHeader, { passive: true });
    window.addEventListener("resize", scheduleHeader, { passive: true });
    window.addEventListener("pageshow", scheduleHeader);
    updateHeader();
  }

  const desktop = window.matchMedia("(min-width: 768px) and (hover: hover) and (pointer: fine)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  // A short entrance plays once; reading never depends on continuing to scroll.
  const entrances = new Set<Animation>();
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      observer.unobserve(entry.target);
      if (reduced.matches || entry.boundingClientRect.top < 0) continue;
      const animation = entry.target.animate([
        { transform: "translateY(10px)", opacity: 0.82 },
        { transform: "translateY(0)", opacity: 1 },
      ], { duration: 700, easing: "cubic-bezier(0.22, 0.61, 0.36, 1)" });
      entrances.add(animation);
      animation.finished.then(() => entrances.delete(animation)).catch(() => entrances.delete(animation));
    }
  }, { threshold: 0.08 });
  document.querySelectorAll('[data-reveal="heading"], [data-reveal="image"], .capabilities__list')
    .forEach((element) => observer.observe(element));
  reduced.addEventListener("change", () => {
    if (reduced.matches) entrances.forEach((animation) => animation.cancel());
  });

  if (desktop.matches && !reduced.matches && header) {
    const [{ gsap }, { ScrollTrigger }, { default: Lenis }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
      import("lenis"),
    ]);

    gsap.registerPlugin(ScrollTrigger);
    const Pane = import.meta.env.DEV ? (await import("tweakpane")).Pane : undefined;
    const media = gsap.matchMedia();
    media.add("(min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)", () => {
    const anchorOffset = () => parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop)
      - header.getBoundingClientRect().height - 8;
    const lenis = new Lenis({
      duration: 1.05,
      smoothWheel: true,
      syncTouch: false,
      anchors: { offset: anchorOffset() },
      stopInertiaOnNavigate: true,
      prevent: (node) => node.classList.contains("pswp"),
    });
    const tick = (time: number) => lenis.raf(time * 1000);
    const pause = () => lenis.stop();
    const resume = () => { lenis.start(); lenis.resize(); };
    const resize = new ResizeObserver(() => { lenis.options.anchors = { offset: anchorOffset() }; });
    lenis.on("scroll", ScrollTrigger.update);
    gsap.ticker.add(tick);
    gsap.ticker.lagSmoothing(0);
    resize.observe(header);
    document.addEventListener("gallery:open", pause);
    document.addEventListener("gallery:close", resume);

    const contactPattern = document.querySelector<HTMLElement>('[data-surface-pattern="diagonal"] .surface-pattern__field');
    let patternTrigger: ScrollTrigger | undefined;
    let patternMotion: gsap.core.Tween | undefined;
    let removePatternListener = () => {};
    let removePointerListeners = () => {};
    if (contactPattern) {
      patternMotion = gsap.to(contactPattern, { x: 8, y: -6, duration: 13, ease: "sine.inOut", repeat: -1, yoyo: true, paused: true });
      const syncPatternMotion = () => {
        const shouldRun = patternTrigger?.isActive === true && document.visibilityState === "visible";
        contactPattern.style.willChange = shouldRun ? "transform" : "auto";
        if (shouldRun) patternMotion?.play(); else patternMotion?.pause();
      };
      patternTrigger = ScrollTrigger.create({ trigger: ".closing-chapter", start: "top bottom", end: "bottom top", onToggle: syncPatternMotion });
      document.addEventListener("visibilitychange", syncPatternMotion);
      removePatternListener = () => document.removeEventListener("visibilitychange", syncPatternMotion);
      syncPatternMotion();
    }

    gsap.to(".hero__image", { yPercent: 1.5, scale: 1.01, ease: "none", scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: 0.65 } });
    document.querySelectorAll(".project--slot-3 .project__media img, .project--slot-5 .project__media img")
      .forEach((image) => gsap.to(image, { yPercent: -1, scale: 1.01, ease: "none", scrollTrigger: { trigger: image.closest(".project"), start: "top bottom", end: "bottom top", scrub: 0.75 } }));

    const openingPattern = document.querySelector<HTMLElement>('[data-surface-pattern="grid"] .surface-pattern__field');
    const focusPattern = document.querySelector<HTMLElement>('[data-surface-pattern="grid"] .surface-pattern__field--focus');
    const hero = document.querySelector<HTMLElement>(".hero");
    if (openingPattern && focusPattern && hero) {
      const gridMotion = { focusOffset: 8, radius: 26, focusOpacity: 0.85 };
      if (Pane) {
        const pane = new Pane({ title: "Tensión local del hero" }) as unknown as {
          addBinding: (target: object, key: string, options: object) => void;
        };
        pane.addBinding(gridMotion, "focusOffset", { min: 2, max: 18, step: 0.5, label: "desplazamiento" });
        pane.addBinding(gridMotion, "radius", { min: 8, max: 42, step: 1, label: "radio" });
        pane.addBinding(gridMotion, "focusOpacity", { min: 0.3, max: 1, step: 0.05, label: "presencia" });
      }
      const applyFocus = (cx: number, cy: number) => {
        focusPattern.style.setProperty("--focus-x", `${cx}%`);
        focusPattern.style.setProperty("--focus-y", `${cy}%`);
        focusPattern.style.setProperty("--focus-r", `${gridMotion.radius}%`);
      };
      const toX = gsap.quickTo(focusPattern, "x", { duration: 0.8, ease: "power2.out" });
      const toY = gsap.quickTo(focusPattern, "y", { duration: 0.8, ease: "power2.out" });
      const toOpacity = gsap.quickTo(focusPattern, "opacity", { duration: 0.3, ease: "power1.out" });
      const moveGrid = (event: PointerEvent) => {
        const bounds = hero.getBoundingClientRect();
        const px = (event.clientX - bounds.left) / bounds.width;
        const py = (event.clientY - bounds.top) / bounds.height;
        applyFocus(px * 100, py * 100);
        toX((px - 0.5) * gridMotion.focusOffset);
        toY((py - 0.5) * gridMotion.focusOffset);
        toOpacity(gridMotion.focusOpacity);
      };
      const leaveGrid = () => {
        toOpacity(0);
        toX(0);
        toY(0);
      };
      applyFocus(50, 50);
      hero.addEventListener("pointermove", moveGrid);
      hero.addEventListener("pointerleave", leaveGrid);
      removePointerListeners = () => {
        hero.removeEventListener("pointermove", moveGrid);
        hero.removeEventListener("pointerleave", leaveGrid);
      };
    }
    document.fonts.ready.then(() => ScrollTrigger.refresh());
    return () => {
      gsap.ticker.remove(tick);
      resize.disconnect();
      removePatternListener();
      removePointerListeners();
      document.removeEventListener("gallery:open", pause);
      document.removeEventListener("gallery:close", resume);
      lenis.destroy();
    };
    });
  }
</script>
