---
import {
  buildWarpedGrid,
  gridStrokeForTone,
  type WarpedGridTone,
  type WarpedGridVariant,
} from "../lib/warpedGrid";

interface Props {
  variant: WarpedGridVariant;
  tone?: WarpedGridTone;
  class?: string;
}

const { variant, tone = "on-canvas", class: className } = Astro.props;
const grid = buildWarpedGrid(variant);
const stroke = gridStrokeForTone(tone);
---

<svg
  class:list={["warped-grid", className]}
  data-warped-grid={variant}
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke={stroke} stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    {grid.lines.map((path) => <path d={path} vector-effect="non-scaling-stroke" />)}
  </g>
</svg>
