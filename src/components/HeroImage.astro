---
import { Picture } from "astro:assets";

import { heroImage } from "../data/projects";
---

<div class="hero__image">
  <Picture
    src={heroImage.src}
    formats={["avif", "webp"]}
    fallbackFormat="jpeg"
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 1100px) 66vw, 100vw"
    alt={heroImage.alt}
    loading="eager"
    decoding="sync"
    fetchpriority="high"
    quality={86}
    style={`object-position: ${heroImage.focalPoint ?? "50% 40%"}`}
  />
</div>
