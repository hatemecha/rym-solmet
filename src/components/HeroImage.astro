---
import { Picture } from "astro:assets";

import { heroImage, projects } from "../data/projects";
import PhotoLink from "./PhotoLink.astro";
const project = projects.find((project) => project.images.some((image) => image.src === heroImage.src))!;
const index = project.images.findIndex((image) => image.src === heroImage.src);
---

<div class="hero__image">
  <PhotoLink project={project} index={index}>
  <Picture
    src={heroImage.src}
    formats={["avif", "webp"]}
    fallbackFormat="jpeg"
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 1100px) 66vw, 100vw"
    alt={heroImage.alt}
    loading="eager"
    decoding="sync"
    fetchpriority="high"
    quality={86}
    style={`object-position: ${heroImage.focalPoint ?? "50% 40%"}`}
  />
  </PhotoLink>
</div>
