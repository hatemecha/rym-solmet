---
import { Picture } from "astro:assets";

import { featuredProjects } from "../data/projects";
---

<div class="project-grid">
  {
    featuredProjects.map((project, index) => (
      <article
        class={`project project--${index + 1} project--${project.layout}`}
        id={project.slug}
      >
        <div
          class:list={["project__media", { "project__media--pair": project.images.length > 1 }]}
        >
          {project.images.map((image) => (
            <Picture
              src={image.src}
              formats={["avif", "webp"]}
              fallbackFormat="jpeg"
              widths={[360, 720, 1200]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1100px) 60vw, 820px"
              alt={image.alt}
              loading="lazy"
              decoding="async"
              quality={82}
              style={`object-position: ${image.focalPoint ?? "50% 50%"}`}
            />
          ))}
        </div>
        <div class="project__caption">
          <h3>{project.title}</h3>
          <p>{project.materials}</p>
        </div>
      </article>
    ))
  }
</div>
