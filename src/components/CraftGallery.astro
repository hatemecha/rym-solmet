---
import { Picture } from "astro:assets";

import { craftProjects } from "../data/projects";
---

<div class="craft-carousel" data-craft-carousel tabindex="0" aria-label="Piezas artesanales">
  <div class="craft-carousel__viewport">
    <div class="craft-carousel__track" data-craft-track>
      {
        craftProjects.map((project, index) => {
          const image = project.images[0];
          return (
            <figure
              class={`craft-item craft-item--${project.order}`}
              data-craft-slide
              data-reveal="image"
              data-reveal-delay={String(index * 80)}
              hidden={index !== 0}
            >
              <Picture
                src={image.src}
                formats={["avif", "webp"]}
                fallbackFormat="jpeg"
                widths={[360, 720, 960]}
                sizes="(max-width: 767px) calc(100vw - 32px), min(32rem, 40vw)"
                alt={image.alt}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                quality={82}
              />
              <figcaption>
                <span>{project.title}</span>
                <span>{project.materials}</span>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>

  <div class="craft-carousel__controls">
    <button
      class="craft-carousel__button"
      type="button"
      data-craft-prev
      aria-label="Pieza anterior"
      disabled
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 6l-6 6 6 6"></path>
      </svg>
    </button>

    <div class="craft-carousel__status" aria-live="polite" data-craft-status>
      {
        craftProjects.map((project, index) => (
          <span data-craft-indicator hidden={index !== 0}>
            {index + 1} / {craftProjects.length} · {project.title}
          </span>
        ))
      }
    </div>

    <button class="craft-carousel__button" type="button" data-craft-next aria-label="Pieza siguiente">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const desktopQuery = matchMedia("(min-width: 48rem)");
  const carousels = document.querySelectorAll<HTMLElement>("[data-craft-carousel]");

  carousels.forEach((carousel) => {
    const slides = [...carousel.querySelectorAll<HTMLElement>("[data-craft-slide]")];
    const indicators = [...carousel.querySelectorAll<HTMLElement>("[data-craft-indicator]")];
    const prevButton = carousel.querySelector<HTMLButtonElement>("[data-craft-prev]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-craft-next]");

    if (!slides.length || !prevButton || !nextButton) {
      return;
    }

    let activeIndex = 0;

    const updateCarousel = () => {
      if (desktopQuery.matches) {
        slides.forEach((slide) => {
          slide.hidden = false;
        });
        indicators.forEach((indicator) => {
          indicator.hidden = true;
        });
        prevButton.disabled = true;
        nextButton.disabled = true;
        return;
      }

      slides.forEach((slide, index) => {
        slide.hidden = index !== activeIndex;
      });

      indicators.forEach((indicator, index) => {
        indicator.hidden = index !== activeIndex;
      });

      prevButton.disabled = activeIndex === 0;
      nextButton.disabled = activeIndex === slides.length - 1;
    };

    prevButton.addEventListener("click", () => {
      if (desktopQuery.matches || activeIndex === 0) {
        return;
      }

      activeIndex -= 1;
      updateCarousel();
    });

    nextButton.addEventListener("click", () => {
      if (desktopQuery.matches || activeIndex === slides.length - 1) {
        return;
      }

      activeIndex += 1;
      updateCarousel();
    });

    carousel.addEventListener("keydown", (event) => {
      if (desktopQuery.matches) {
        return;
      }

      if (event.key === "ArrowLeft" && activeIndex > 0) {
        event.preventDefault();
        activeIndex -= 1;
        updateCarousel();
      }

      if (event.key === "ArrowRight" && activeIndex < slides.length - 1) {
        event.preventDefault();
        activeIndex += 1;
        updateCarousel();
      }
    });

    desktopQuery.addEventListener("change", updateCarousel);
    updateCarousel();
  });
</script>
