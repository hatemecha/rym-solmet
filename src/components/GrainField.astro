---
interface Props { reverse?: boolean; }
const { reverse = false } = Astro.props;
---

<div class:list={["grain-field", { "grain-field--reverse": reverse }]} aria-hidden="true"></div>

<style>
  .grain-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink);
  }
  .grain-field::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-ink-muted);
    opacity: 0.24;
    mix-blend-mode: soft-light;
    mask-image: radial-gradient(ellipse at 100% 0%, #0009, transparent 65%);
  }
  .grain-field::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--noise-image);
    background-size: 200px 200px;
    filter: grayscale(1) contrast(450%);
    opacity: 0.48;
    mix-blend-mode: overlay;
  }
  .grain-field--reverse::before {
    mask-image: linear-gradient(#0006, transparent 30%, transparent 80%, #0002);
  }
</style>
