---
import ArrowIcon from "../components/ArrowIcon.astro";
import CraftGallery from "../components/CraftGallery.astro";
import ContactSection from "../components/ContactSection.astro";
import HeroImage from "../components/HeroImage.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SurfacePattern from "../components/SurfacePattern.astro";
import GrainField from "../components/GrainField.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <SiteHeader />

  <div class="opening-chapter" data-chapter="ink">
    <GrainField />
    <SurfacePattern variant="grid" />
    <section class="hero page-shell" id="inicio" aria-labelledby="hero-title">
      <div class="hero__media" data-hero-media>
        <HeroImage />
        <div class="hero__content">
          <div class="hero__panel">
          <h1 id="hero-title" data-hero-title>Herrería y fabricación a medida</h1>
          <div class="hero__meta">
            <p>{site.location}</p>
            <a href={site.whatsapp}>
              Consultar por WhatsApp
              <ArrowIcon />
            </a>
          </div>
          </div>
        </div>
        <span class="hero__scribe" aria-hidden="true">Estructuras metálicas · Galpones y cubiertas · Frentes de parrilla · Portones y cerramientos</span>
      </div>
    </section>
  </div>

  <main id="contenido">
    <section class="portfolio" id="trabajos" aria-labelledby="portfolio-title" data-chapter="canvas">
      <SurfacePattern variant="dots" />
      <div class="section-divider" data-reveal="divider" aria-hidden="true"></div>
      <div class="portfolio__inner page-shell">
        <header class="section-heading" data-reveal="heading">
          <h2 id="portfolio-title">Trabajos seleccionados</h2>
          <p>
            Trabajos terminados en Bahía Blanca y alrededores.
          </p>
        </header>
        <ProjectGallery />
      </div>
    </section>

    <section class="capabilities" id="servicios" aria-labelledby="capabilities-title" data-chapter="steel">
      <div class="section-divider" data-reveal="divider" aria-hidden="true"></div>
      <div class="capabilities__inner page-shell">
        <div class="capabilities__intro" data-reveal="heading">
          <h2 id="capabilities-title">Trabajo en metal y madera.</h2>
          <p>
            Estructuras, portones, cubiertas, frentes de parrilla y piezas a medida.
          </p>
        </div>
        <ul class="capabilities__list" aria-label="Trabajos que realiza RYM Solmet" data-reveal="list">
          {
            [
              "Estructuras metálicas",
              "Galpones y cubiertas",
              "Frentes de parrilla",
              "Portones y cerramientos",
              "Trabajos artesanales",
            ].map((capability) => (
              <li>
                <span>{capability}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="craft" aria-labelledby="craft-title" data-chapter="raised">
      <div class="section-divider" data-reveal="divider" aria-hidden="true"></div>
      <div class="craft__inner page-shell">
        <header class="craft__heading" data-reveal="heading">
          <h2 id="craft-title">Piezas a medida.</h2>
          <p>Trabajos artesanales en metal y madera.</p>
        </header>
        <CraftGallery />
      </div>
    </section>

    <ContactSection />
  </main>
  <SiteFooter />
</BaseLayout>
