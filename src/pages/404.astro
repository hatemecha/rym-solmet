---
import ArrowIcon from "../components/ArrowIcon.astro";
import GrainField from "../components/GrainField.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SurfacePattern from "../components/SurfacePattern.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const homePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  noindex
  title={`Página no encontrada | ${site.name}`}
  description="Esta página no existe. Volvé al inicio de RYM Solmet o consultá por WhatsApp."
>
  <SiteHeader homePath={homePath} />

  <main id="contenido" tabindex="-1">
    <section
      class="closing-chapter contact not-found"
      aria-labelledby="not-found-title"
      data-chapter="ink"
    >
      <GrainField />
      <SurfacePattern variant="grid" />
      <div class="contact__stage page-shell">
        <div class="contact__inner">
          <div class="contact__intro">
            <p class="not-found__code">404</p>
            <h1 id="not-found-title">Página no encontrada.</h1>
            <p>El enlace no existe o se movió. Volvé al inicio para ver los trabajos.</p>
          </div>
          <div class="contact__panel not-found__actions">
            <a class="contact__primary" href={homePath}>
              <span>Volver al inicio</span>
              <ArrowIcon />
            </a>
            <a class="not-found__secondary" href={site.whatsapp}>Consultar por WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
